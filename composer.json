{
    "name": "kinetis/telemetry",
    "description": "OpenTelemetry tracing for Kinetis — request spans, framework instrumentation hooks, decorators for the cache, session, HTTP and OpenSearch boundaries, and OTLP export over the Revolt-backed client.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "dev-main",
        "kinetis/revolt-http-client": "dev-main",
        "open-telemetry/sdk": "^1.15.0",
        "open-telemetry/exporter-otlp": "^1.4.0",
        "symfony/http-client": "^8.1.4",
        "symfony/http-client-contracts": "^3.7.1",
        "nyholm/psr7": "^1.8.2",
        "psr/log": "^3.0.2"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "kinetis/cache-redis": "dev-main",
        "kinetis/persistence": "dev-main",
        "kinetis/redis": "dev-main",
        "kinetis/search-opensearch": "dev-main",
        "kinetis/session": "dev-main",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.33",
        "vimeo/psalm": "^6.16.1"
    },
    "suggest": {
        "kinetis/persistence": "Query and transaction spans, reported from inside the drivers through the framework's instrumentation hooks.",
        "kinetis/queue": "Producer and consumer job spans, reported by the queue backends and the worker through the framework's instrumentation hooks.",
        "kinetis/cache-redis": "Enables the TracingSimpleCache decorator — a span per cache operation.",
        "kinetis/session": "Enables the TracingSessionStore decorator — a span per session read, create, update and destroy.",
        "kinetis/search-opensearch": "Enables the TracingOpenSearchTransport decorator, via OpenSearchClientFactory's transportDecorator seam — a span per OpenSearch call."
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\Telemetry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\Telemetry\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kinetis": {
            "scan": "Kinetis\\Telemetry\\Middleware\\",
            "bootstrap": "Kinetis\\Telemetry\\PackageBootstrap"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../persistence"
        },
        {
            "type": "path",
            "url": "../cache-redis"
        },
        {
            "type": "path",
            "url": "../redis"
        },
        {
            "type": "path",
            "url": "../session"
        },
        {
            "type": "path",
            "url": "../search-opensearch"
        },
        {
            "type": "path",
            "url": "../framework"
        },
        {
            "type": "path",
            "url": "../revolt-http-client"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
